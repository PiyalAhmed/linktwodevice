<ui:FluentWindow x:Class="LinkTwo.UI.PairingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pair your phone" Width="420" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <StackPanel>
        <ui:TitleBar Title="Pair your phone" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="28,8,28,24">
            <ui:TextBlock Text="Scan with LinkTwo on your phone" FontTypography="Subtitle" TextAlignment="Center" />
            <ui:TextBlock x:Name="Subtitle" Appearance="Secondary" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
            <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Center">
                <Image x:Name="Qr" Width="232" Height="232" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,6,0" Opacity="0.7" />
                <ui:TextBlock Text="The code contains the encryption key. Don't share it." FontTypography="Caption" Appearance="Secondary" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0" />
                <ui:TextBlock Text="Waiting for your phone…" Appearance="Secondary" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
