<ui:FluentWindow x:Class="LinkTwo.UI.TrayFlyout"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:LinkTwo.UI"
                 Title="LinkTwo" Width="360" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Acrylic" WindowCornerPreference="Round"
                 WindowStartupLocation="Manual">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- Quick Settings–style tile. -->
        <Style x:Key="Tile" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <StackPanel x:Name="Root" Margin="16,16,16,12" RenderTransformOrigin="0.5,1">
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0" />
        </StackPanel.RenderTransform>

        <!-- Phone + status -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentFillColorDefaultBrush}">
                <ui:SymbolIcon Symbol="Phone24" FontSize="18" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <ui:TextBlock Text="{Binding PhoneTitle}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" />
                        <ui:ProgressRing Width="10" Height="10" IsIndeterminate="True"
                                         Visibility="{Binding Reconnecting, Converter={StaticResource Visible}}" />
                    </Grid>
                    <ui:TextBlock Text="{Binding StatusText}" FontTypography="Caption" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon Settings24}" ToolTip="Open LinkTwo"
                       Click="Open_Click" Focusable="False" />
        </Grid>

        <!-- Now Playing -->
        <local:NowPlayingView Margin="0,14,0,0" DataContext="{Binding NowPlaying}"
                              Visibility="{Binding DataContext.HasNowPlaying, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

        <!-- Quick actions -->
        <UniformGrid Columns="2" Margin="-4,10,-4,0">
            <ui:Button Style="{StaticResource Tile}" Click="SendFiles_Click" IsEnabled="{Binding CanSend}" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="Send files" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button Style="{StaticResource Tile}" Click="Clipboard_Click" IsEnabled="{Binding CanSend}" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="Clipboard" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button Style="{StaticResource Tile}" Click="Pause_Click" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{Binding PauseSymbol}" FontSize="18" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding PauseLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button Style="{StaticResource Tile}" Click="Reconnect_Click" Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="18" Height="18" Margin="0,0,10,0">
                        <ui:SymbolIcon x:Name="ReconnectIcon" Symbol="ArrowSync24" FontSize="18" />
                        <ui:ProgressRing x:Name="ReconnectSpinner" Width="18" Height="18" IsIndeterminate="True" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="ReconnectText" Text="Reconnect" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </UniformGrid>

        <Separator Margin="0,10,0,6" Opacity="0.4" />
        <Grid>
            <ui:Button Appearance="Transparent" Content="Open LinkTwo" Click="Open_Click" HorizontalAlignment="Left" Focusable="False" />
            <ui:Button Appearance="Transparent" Content="Quit" Click="Quit_Click" HorizontalAlignment="Right" Focusable="False" />
        </Grid>
    </StackPanel>
</ui:FluentWindow>
