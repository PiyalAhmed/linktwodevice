<UserControl x:Class="LinkTwo.UI.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:LinkTwo.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:InverseBoolToVisibility x:Key="Hidden" />
        <local:InverseBool x:Key="InverseBool" />
        <Style x:Key="Section" TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type ui:TextBlock}}">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="2,24,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="760">
            <ui:TextBlock Text="Overview" FontTypography="Title" Margin="0,0,0,16" />

            <!-- Phone -->
            <ui:Card>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ui:SymbolIcon Symbol="Phone24" FontSize="28" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding PhoneTitle}" FontTypography="Subtitle" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Grid Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}"
                                             Visibility="{Binding Reconnecting, Converter={StaticResource Hidden}}" />
                                    <ui:ProgressRing Width="12" Height="12" IsIndeterminate="True"
                                                     Visibility="{Binding Reconnecting, Converter={StaticResource Visible}}" />
                                </Grid>
                                <ui:TextBlock Text="{Binding StatusText}" Appearance="Secondary" />
                            </StackPanel>
                            <ui:TextBlock Text="{Binding SinceText}" FontTypography="Caption" Appearance="Tertiary" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Icon="{ui:SymbolIcon PauseCircle24}" Content="{Binding PauseLabel}" Click="Pause_Click" Margin="0,0,8,0" />
                        <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Reconnect" Click="Reconnect_Click"
                                   ToolTip="Drop the connection and let the phone connect again"
                                   IsEnabled="{Binding Reconnecting, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Margin="0,12,0,0" Severity="Warning" IsClosable="False"
                        Title="Notifications are turned off"
                        Message="Phone notifications can't appear on this PC until LinkTwo is allowed to show them."
                        IsOpen="{Binding NotificationsAllowed, Converter={StaticResource InverseBool}}" />
            <ui:Button Margin="0,6,0,0" Content="Open notification settings" Click="NotificationSettings_Click"
                       Visibility="{Binding NotificationsAllowed, Converter={StaticResource Hidden}}" />

            <!-- Now Playing -->
            <StackPanel Visibility="{Binding HasNowPlaying, Converter={StaticResource Visible}}">
                <ui:TextBlock Text="Now playing" Style="{StaticResource Section}" />
                <local:NowPlayingView DataContext="{Binding NowPlaying}" />
            </StackPanel>

            <!-- Send to phone -->
            <ui:TextBlock Text="Send to phone" Style="{StaticResource Section}" />
            <ui:Card>
                <StackPanel>
                    <Grid x:Name="DropZone" Height="110" AllowDrop="True" Background="Transparent"
                          DragEnter="Drop_DragEnter" DragLeave="Drop_DragLeave" Drop="Drop_Drop">
                        <Rectangle x:Name="DropBorder" RadiusX="6" RadiusY="6" StrokeThickness="1.2" StrokeDashArray="4 3"
                                   Stroke="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="26" Opacity="0.7" HorizontalAlignment="Center" />
                            <ui:TextBlock x:Name="DropText" Text="Drop files here" Appearance="Secondary" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding CanSend}">
                        <ui:Button Icon="{ui:SymbolIcon ArrowUpload24}" Content="Choose files…" Click="ChooseFiles_Click" Margin="0,0,8,0" />
                        <ui:Button Icon="{ui:SymbolIcon ClipboardPaste24}" Content="Send clipboard" Click="SendClipboard_Click" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Received from phone -->
            <ui:TextBlock Text="Received from phone" Style="{StaticResource Section}" />
            <ui:CardControl Icon="{ui:SymbolIcon Folder24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Save to" />
                        <ui:HyperlinkButton Content="{Binding SaveFolder}" Padding="0" Click="OpenFolder_Click" ToolTip="Open in File Explorer" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Use default" Click="ResetFolder_Click" Margin="0,0,8,0"
                               Visibility="{Binding SaveFolderIsDefault, Converter={StaticResource Hidden}}" />
                    <ui:Button Content="Choose…" Click="ChooseFolder_Click" />
                </StackPanel>
            </ui:CardControl>

            <!-- Clipboard -->
            <ui:TextBlock Text="Clipboard" Style="{StaticResource Section}" />
            <ui:CardControl Icon="{ui:SymbolIcon ClipboardPaste24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Sync clipboard to phone" />
                        <ui:TextBlock Text="Text you copy on this PC is ready to paste on your phone." FontTypography="Caption" Appearance="Secondary" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ClipboardSync, Mode=OneWay}" Click="ClipboardSync_Click" />
            </ui:CardControl>

            <!-- General -->
            <ui:TextBlock Text="General" Style="{StaticResource Section}" />
            <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <ui:TextBlock Text="Start with Windows" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=OneWay}" Click="StartWithWindows_Click" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon PhoneLaptop24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Paired phone" />
                        <ui:TextBlock Text="{Binding PhoneTitle}" FontTypography="Caption" Appearance="Secondary" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon QrCode24}" Content="Pair new phone…" Click="Pair_Click" Margin="0,0,8,0" />
                    <ui:Button Appearance="Danger" Content="Reset pairing…" Click="ResetPairing_Click" />
                </StackPanel>
            </ui:CardControl>

            <ui:HyperlinkButton Margin="0,20,0,0" Content="Open log folder" Click="Logs_Click" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
