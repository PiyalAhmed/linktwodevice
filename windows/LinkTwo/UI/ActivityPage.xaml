<UserControl x:Class="LinkTwo.UI.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- Segmented tabs: radio buttons drawn as toggle buttons. -->
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="GroupName" Value="ActivityTabs" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Text="Activity" FontTypography="Title" />

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabNotifications" Style="{StaticResource Segment}" Content="Notifications" Checked="Tab_Checked" />
                <RadioButton x:Name="TabActivities" Style="{StaticResource Segment}" Content="Activities" Checked="Tab_Checked" />
                <RadioButton x:Name="TabAll" Style="{StaticResource Segment}" Content="All" Checked="Tab_Checked" />
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon Delete24}" Content="Clear" Click="Clear_Click" />
        </Grid>

        <ListView x:Name="List" Grid.Row="2" BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Top">
                            <Border CornerRadius="7" Background="{Binding SymbolBackground}">
                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="White" />
                            </Border>
                            <Border CornerRadius="7" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" />
                            <ui:TextBlock Text="{Binding Detail}" Appearance="Secondary" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="44" Height="44" CornerRadius="6" Margin="0,0,12,0"
                                Visibility="{Binding HasImage, Converter={StaticResource Visible}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                            <ui:TextBlock Text="{Binding TimeText}" FontTypography="Caption" Appearance="Secondary" HorizontalAlignment="Right" />
                            <ui:TextBlock Text="{Binding App}" FontTypography="Caption" Appearance="Tertiary" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <ui:SymbolIcon x:Name="EmptyIcon" Symbol="Alert24" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
            <ui:TextBlock x:Name="EmptyTitle" Text="No notifications" FontTypography="Subtitle" Margin="0,12,0,4" HorizontalAlignment="Center" />
            <ui:TextBlock Text="Things appear here as they happen while you're using this PC. Nothing is sent while it's locked or asleep."
                          Appearance="Secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
        </StackPanel>

        <ui:TextBlock Grid.Row="3" Text="Live only — this list is forgotten when LinkTwo quits." FontTypography="Caption"
                      Appearance="Tertiary" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </Grid>
</UserControl>
